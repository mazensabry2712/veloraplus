APP_NAME=VeloraPlus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://velora.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=central
CENTRAL_DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=veloraplus
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


VELORA_PLATFORM_DOMAIN=velora.com
VELORA_PLATFORM_URL=https://velora.com
VELORA_TENANT_BASE_DOMAIN=velora.com
VELORA_TENANT_SCHEME=https
VELORA_CACHE_VERSION=v1

# Central/control database
CENTRAL_DB_HOST=127.0.0.1
CENTRAL_DB_PORT=3306
CENTRAL_DB_DATABASE=veloraplus
CENTRAL_DB_USERNAME=root
CENTRAL_DB_PASSWORD=

# Tenant database template/host defaults. Leave username/password empty to inherit Central DB credentials.
TENANT_DB_CONNECTION=mysql
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=
TENANT_DB_PASSWORD=

VELORA_PLATFORM_PAYMENT_PROVIDER=kashier
VELORA_TENANT_PAYMENT_PROVIDER=kashier

# Kashier test/live credentials. Never commit real credentials.
KASHIER_MODE=test
KASHIER_TEST_API_BASE_URL=https://test-api.kashier.io
KASHIER_LIVE_API_BASE_URL=https://api.kashier.io
KASHIER_TEST_FEP_BASE_URL=https://test-fep.kashier.io
KASHIER_LIVE_FEP_BASE_URL=https://fep.kashier.io
KASHIER_SECRET_KEY=
KASHIER_PAYMENT_API_KEY=
KASHIER_MERCHANT_ID=
KASHIER_MERCHANT_REDIRECT_URL=
KASHIER_WEBHOOK_URL=
KASHIER_ALLOWED_METHODS=card,wallet
KASHIER_MAX_FAILURE_ATTEMPTS=3
